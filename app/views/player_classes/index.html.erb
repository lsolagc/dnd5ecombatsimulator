<% content_for :title, "Classes disponíveis" %>

<% spellcasting_labels = { "intelligence" => "Inteligência", "wisdom" => "Sabedoria", "charisma" => "Carisma" } %>

<div class="w-100">
  <% if notice.present? %>
    <p class="alert alert-success d-inline-block mb-3" id="notice"><%= notice %></p>
  <% end %>

  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h1 class="fw-bold mb-1">Classes disponíveis</h1>
      <p class="small text-body-secondary mb-0"><%= pluralize(@player_classes.count, "classe") %> · <%= pluralize(@total_features_count, "feature cadastrada", plural: "features cadastradas") %></p>
    </div>
    <%= link_to "Nova classe", new_player_class_path, class: "btn btn-primary" %>
  </div>

  <%= form_with url: player_classes_path, method: :get, class: "row g-2 mb-3" do |form| %>
    <div class="col">
      <%= form.text_field :q, value: params[:q], placeholder: "Buscar por nome", class: "form-control" %>
    </div>
    <div class="col-auto" style="width: 12rem;">
      <%= form.select :hit_die, options_for_select(PlayerClass.hit_dice.keys.zip(PlayerClass.hit_dice.keys), params[:hit_die]), { include_blank: "Dado de vida" }, class: "form-select", onchange: "this.form.requestSubmit()" %>
    </div>
    <div class="col-auto" style="width: 14rem;">
      <%= form.select :spellcasting_modifier, options_for_select(PlayerClass.spellcasting_modifiers.keys.map { |key| [ spellcasting_labels[key], key ] }, params[:spellcasting_modifier]), { include_blank: "Conjuração" }, class: "form-select", onchange: "this.form.requestSubmit()" %>
    </div>
    <div class="col-auto">
      <%= form.submit "Filtrar", class: "btn btn-outline-secondary" %>
    </div>
  <% end %>

  <div id="player_classes">
    <% if @player_classes.any? %>
      <table class="table align-middle mb-0">
        <thead>
          <tr class="small text-uppercase text-body-secondary">
            <th style="width: 2rem;"></th>
            <th>Nome</th>
            <th>Dado de vida</th>
            <th>Conjuração</th>
            <th>Features</th>
          </tr>
        </thead>
        <% @player_classes.each do |player_class| %>
          <tbody data-controller="class-row">
            <tr role="button" data-action="click->class-row#toggle">
              <td><span data-class-row-target="chevron">▸</span></td>
              <td class="fw-semibold"><%= player_class.name %></td>
              <td class="font-monospace"><%= player_class.hit_die %></td>
              <td><%= spellcasting_labels[player_class.spellcasting_modifier] || "—" %></td>
              <td><%= player_class.class_features.size %></td>
            </tr>
            <tr class="d-none" data-class-row-target="detail">
              <td></td>
              <td colspan="4" class="pb-4">
                <div class="row g-4">
                  <div class="col-md-5">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Progressão</p>
                    <% if player_class.class_level_progressions.any? %>
                      <table class="table table-sm table-bordered bg-body mb-0">
                        <thead>
                          <tr class="small text-uppercase text-body-secondary">
                            <th>Nv</th>
                            <th>Prof.</th>
                            <th>Ataques</th>
                            <th>ASI</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% player_class.class_level_progressions.sort_by(&:level).each do |progression| %>
                            <tr>
                              <td><%= progression.level %></td>
                              <td class="font-monospace">+<%= progression.proficiency_bonus %></td>
                              <td><%= progression.attacks_per_action %></td>
                              <td><%= progression.grants_ability_score_improvement? ? "sim" : "—" %></td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    <% else %>
                      <p class="small text-body-secondary">Sem progressão cadastrada.</p>
                    <% end %>
                  </div>
                  <div class="col-md-7">
                    <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Features</p>
                    <% if player_class.class_features.any? %>
                      <div class="d-flex flex-wrap gap-2 mb-2">
                        <% player_class.class_features.each do |feature| %>
                          <% has_effect = feature.class_feature_unlocks.any? { |unlock| unlock.effect_payload.present? } %>
                          <span class="badge rounded-pill <%= feature.action_type_passive? ? "bg-body-secondary text-body-secondary border" : "border border-2 text-body bg-body" %>">
                            <% if has_effect %><span class="text-primary">●</span> <% end %><%= feature.name %>
                          </span>
                        <% end %>
                      </div>
                      <p class="small text-body-secondary mb-0">Borda dupla = ação · fundo cinza = passiva · ● = com efeito estruturado.</p>
                    <% else %>
                      <p class="small text-body-secondary">Sem features cadastradas.</p>
                    <% end %>
                  </div>
                </div>
              </td>
            </tr>
          </tbody>
        <% end %>
      </table>
    <% else %>
      <p class="text-center my-5"><b>Nenhuma classe encontrada.</b></p>
    <% end %>
  </div>
</div>
