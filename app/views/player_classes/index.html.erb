<% content_for :title, "Player classes" %>

<div class="w-100">
  <% if notice.present? %>
    <p class="alert alert-success d-inline-block mb-3" id="notice"><%= notice %></p>
  <% end %>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fw-bold">Player classes</h1>
    <%= link_to "New player class", new_player_class_path, class: "btn btn-primary" %>
  </div>

  <div id="player_classes">
    <% if @player_classes.any? %>
      <table class="table table-striped">
        <thead>
          <tr>
            <% PlayerClass.humanized_table_columns.each do |column| %>
              <th><%= column %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @player_classes.each do |player_class| %>
            <tr>
              <td><%= player_class.name %></td>
              <td><%= player_class.hit_die %></td>
              <td><%= player_class.description %></td>
              <td><%= player_class.spellcasting_modifier %></td>
              <td><%= player_class.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
              <td><%= player_class.updated_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
              <td class="d-flex gap-2">
                <%= link_to "Show", player_class, class: "btn btn-sm btn-outline-secondary" %>
                <%= link_to "Edit", edit_player_class_path(player_class), class: "btn btn-sm btn-outline-secondary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-center my-5"><b>No player classes found.</b></p>
    <% end %>
  </div>
</div>
