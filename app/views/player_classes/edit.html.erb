<% content_for :title, "Editar #{@player_class.name}" %>

<div class="w-100">
  <h1 class="fw-bold mb-3">Editar <%= @player_class.name %></h1>

  <%= render "form", player_class: @player_class %>

  <div class="d-flex gap-2 mt-3">
    <%= link_to "Ver classe", @player_class, class: "btn btn-outline-secondary" %>
    <%= link_to "Voltar para classes", player_classes_path, class: "btn btn-outline-secondary" %>
  </div>
</div>
