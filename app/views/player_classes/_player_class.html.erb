<div id="<%= dom_id player_class %>" class="my-3 d-flex flex-column gap-2">
  <div>
    <strong class="d-block fw-medium mb-1">Name:</strong>
    <%= player_class.name %>
  </div>
  <div>
    <strong class="d-block fw-medium mb-1">Hit die:</strong>
    <%= player_class.hit_die %>
  </div>
  <div>
    <strong class="d-block fw-medium mb-1">Description:</strong>
    <%= player_class.description %>
  </div>
  <div>
    <strong class="d-block fw-medium mb-1">Spellcasting modifier:</strong>
    <%= player_class.spellcasting_modifier %>
  </div>
</div>
