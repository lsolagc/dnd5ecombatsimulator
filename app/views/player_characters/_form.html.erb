<%= form_with(model: player_character) do |form| %>
  <% if player_character.errors.any? %>
    <div id="error_explanation" class="alert alert-danger mt-3">
      <h2><%= pluralize(player_character.errors.count, "error") %> prohibited this player_character from being saved:</h2>

      <ul>
        <% player_character.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: ["form-control", { "is-invalid": player_character.errors[:name].any? }] %>
  </div>

  <div class="mb-3">
    <%= form.label :level, class: "form-label" %>
    <%= form.number_field :level, class: ["form-control", { "is-invalid": player_character.errors[:level].any? }] %>
  </div>

  <div class="mb-3">
    <%= form.label :player_class_id, class: "form-label" %>
    <%= form.text_field :player_class_id, class: ["form-control", { "is-invalid": player_character.errors[:player_class_id].any? }] %>
  </div>

  <div class="mb-3">
    <%= form.label :max_hit_points_input, "HP máximo", class: "form-label" %>
    <%= form.number_field :max_hit_points_input,
          value: player_character.max_hit_points_input.presence || player_character.combatant&.max_hit_points,
          class: ["form-control", { "is-invalid": player_character.errors[:max_hit_points_input].any? }] %>
  </div>

  <div class="d-inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
