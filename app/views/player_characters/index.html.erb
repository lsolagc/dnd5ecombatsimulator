<% content_for :title, "Player characters" %>

<div class="w-100">
  <% if notice.present? %>
    <p class="alert alert-success d-inline-block mb-3" id="notice"><%= notice %></p>
  <% end %>

  <div class="d-flex justify-content-between align-items-center">
    <h1 class="fw-bold">Player characters</h1>
    <%= link_to "New player character", new_player_character_path, class: "btn btn-primary" %>
  </div>

  <div id="player_characters" class="d-flex flex-column gap-3">
    <% if @player_characters.any? %>
      <% @player_characters.each do |player_character| %>
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pb-3 pb-sm-0">
          <%= render player_character %>
          <div class="d-flex flex-column flex-sm-row gap-2">
            <%= link_to "Show", player_character, class: "btn btn-outline-secondary" %>
            <%= link_to "Edit", edit_player_character_path(player_character), class: "btn btn-outline-secondary" %>
            <%= button_to "Destroy", player_character, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-5">No player characters found.</p>
    <% end %>
  </div>
</div>
