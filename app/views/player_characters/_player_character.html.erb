<div id="<%= dom_id player_character %>" class="my-3 d-flex flex-column gap-2">
  <div>
    <strong class="d-block fw-medium mb-1">Name:</strong>
    <%= player_character.name %>
  </div>
  <div>
    <strong class="d-block fw-medium mb-1">Level:</strong>
    <%= player_character.level %>
  </div>
  <div>
    <strong class="d-block fw-medium mb-1">Player class:</strong>
    <%= player_character.player_class_id %>
  </div>
</div>
