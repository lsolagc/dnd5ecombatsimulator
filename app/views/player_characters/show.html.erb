<% content_for :title, @player_character.name %>

<% ability_labels = { "strength" => "Força", "dexterity" => "Destreza", "constitution" => "Constituição", "intelligence" => "Inteligência", "wisdom" => "Sabedoria", "charisma" => "Carisma" } %>

<div class="w-100">
  <% if notice.present? %>
    <p class="alert alert-success d-inline-block mb-3" id="notice"><%= notice %></p>
  <% end %>

  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <h1 class="fw-bold mb-1"><%= @player_character.name %></h1>
      <p class="text-body-secondary mb-0"><%= @player_character.player_class.name %> · nível <%= @player_character.level %></p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "Gambits", player_character_gambits_path(@player_character), class: "btn btn-outline-primary" %>
      <%= link_to "Editar", edit_player_character_path(@player_character), class: "btn btn-outline-secondary" %>
      <%= button_to "Excluir", @player_character, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Tem certeza?" } %>
    </div>
  </div>

  <div class="row row-cols-2 row-cols-md-5 g-2 mb-4">
    <div class="col">
      <div class="border rounded p-2 text-center">
        <p class="small text-uppercase text-body-secondary mb-1">HP máx.</p>
        <p class="fw-semibold font-monospace mb-0"><%= @player_character.max_hit_points %></p>
      </div>
    </div>
    <div class="col">
      <div class="border rounded p-2 text-center">
        <p class="small text-uppercase text-body-secondary mb-1">CA</p>
        <p class="fw-semibold font-monospace mb-0"><%= @player_character.armor_class %></p>
      </div>
    </div>
    <div class="col">
      <div class="border rounded p-2 text-center">
        <p class="small text-uppercase text-body-secondary mb-1">Deslocamento</p>
        <p class="fw-semibold font-monospace mb-0"><%= @player_character.combatant.speed %> ft</p>
      </div>
    </div>
    <div class="col">
      <div class="border rounded p-2 text-center">
        <p class="small text-uppercase text-body-secondary mb-1">Bônus prof.</p>
        <p class="fw-semibold font-monospace mb-0">+<%= @player_character.proficiency_bonus %></p>
      </div>
    </div>
    <div class="col">
      <div class="border rounded p-2 text-center">
        <p class="small text-uppercase text-body-secondary mb-1">Ataques</p>
        <p class="fw-semibold font-monospace mb-0"><%= @player_character.attacks_per_action %></p>
      </div>
    </div>
  </div>

  <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Atributos</p>
  <div class="row row-cols-3 row-cols-md-6 g-2 mb-4">
    <% ability_labels.each do |ability, label| %>
      <div class="col">
        <div class="border rounded p-2 text-center">
          <p class="small fw-semibold mb-0"><%= label %></p>
          <p class="font-monospace mb-0"><%= @player_character.public_send(ability) %></p>
          <p class="small text-body-secondary font-monospace mb-0">MOD <%= "%+d" % @player_character.public_send("#{ability}_modifier") %></p>
        </div>
      </div>
    <% end %>
  </div>

  <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Resistências, imunidades e vulnerabilidades</p>
  <% defenses = @player_character.defenses %>
  <% flagged_damage_types = damage_type_labels.select { |type, _| defenses.flag(type) } %>
  <% if flagged_damage_types.any? %>
    <div class="d-flex flex-wrap gap-2 mb-4">
      <% flagged_damage_types.each do |type, label| %>
        <span class="badge rounded-pill border wizard-chip wizard-chip--active"><%= label %> <span class="font-monospace"><%= defenses.flag(type) %></span></span>
      <% end %>
    </div>
  <% else %>
    <p class="small text-body-secondary mb-4">Nenhuma resistência, imunidade ou vulnerabilidade registrada.</p>
  <% end %>

  <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Features de <%= @player_character.player_class.name %></p>
  <% if @player_character.player_class.class_features.any? %>
    <div class="d-flex flex-wrap gap-2 mb-4">
      <% @player_character.player_class.class_features.each do |feature| %>
        <% earliest_level = feature.class_feature_unlocks.map(&:level).min %>
        <span class="badge rounded-pill <%= feature.action_type_passive? ? "bg-body-secondary text-body-secondary border" : "border border-2 text-body bg-body" %>">
          <%= feature.name %><% if earliest_level %> <span class="font-monospace small">nv <%= earliest_level %></span><% end %>
        </span>
      <% end %>
    </div>
  <% else %>
    <p class="small text-body-secondary mb-4">Sem features cadastradas.</p>
  <% end %>

  <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Gambits</p>
  <% gambits = @player_character.gambits.includes(:class_feature, :spell) %>
  <% if gambits.any? %>
    <ol class="list-unstyled mb-4" id="gambits_summary">
      <% gambits.each do |gambit| %>
        <li class="<%= "text-body-secondary opacity-50" unless gambit.enabled? %>">
          <span class="font-monospace fw-semibold"><%= gambit.position %></span> <%= gambit.label %><%= " (desligado)" unless gambit.enabled? %>
        </li>
      <% end %>
    </ol>
    <% if gambits.none?(&:enabled?) %>
      <p class="small text-body-secondary mb-4">Todos desligados: ação aleatória.</p>
    <% end %>
  <% else %>
    <p class="small text-body-secondary mb-4">Sem gambits: ação aleatória</p>
  <% end %>

  <%= link_to "Voltar para personagens", player_characters_path, class: "btn btn-outline-secondary" %>
</div>
