<% content_for :title, "Showing player character" %>

<div class="w-100">
  <% if notice.present? %>
    <p class="alert alert-success d-inline-block mb-3" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="fw-bold">Showing player character</h1>

  <%= render @player_character %>

  <%= link_to "Edit this player character", edit_player_character_path(@player_character), class: "btn btn-outline-secondary" %>
  <%= link_to "Back to player characters", player_characters_path, class: "btn btn-outline-secondary mt-2 mt-sm-0 ms-sm-2" %>
  <%= button_to "Destroy this player character", @player_character, method: :delete, form_class: "d-sm-inline-block mt-2 mt-sm-0 ms-sm-2", class: "btn btn-danger w-100", data: { turbo_confirm: "Are you sure?" } %>
</div>
