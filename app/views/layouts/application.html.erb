<!DOCTYPE html>
<html data-bs-theme="<%= cookies[:theme] == "dark" ? "dark" : "light" %>">
  <head>
    <title><%= content_for(:title) || "Dnd" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand border-bottom py-3">
      <div class="container-fluid">
        <%= link_to "D20 · SIM", root_path, class: "navbar-brand fw-bold text-uppercase small" %>

        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <%= link_to "Início", root_path, class: "nav-link#{" active fw-semibold" if current_page?(root_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Personagens", player_characters_path, class: "nav-link#{" active fw-semibold" if controller_name == "player_characters"}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Classes", player_classes_path, class: "nav-link#{" active fw-semibold" if controller_name == "player_classes"}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Simulações", "#", class: "nav-link disabled", aria: { disabled: true }, tabindex: "-1" %>
          </li>
        </ul>

        <div class="btn-group btn-group-sm" role="group" data-controller="theme" data-theme-preference-value="<%= cookies[:theme] || "system" %>">
          <button type="button" class="btn btn-outline-secondary" data-theme-target="option" data-action="theme#choose" data-theme-value="light">Claro</button>
          <button type="button" class="btn btn-outline-secondary" data-theme-target="option" data-action="theme#choose" data-theme-value="dark">Escuro</button>
          <button type="button" class="btn btn-outline-secondary" data-theme-target="option" data-action="theme#choose" data-theme-value="system">Sistema</button>
        </div>
      </div>
    </nav>

    <main class="container-fluid p-4">
      <%= yield %>
    </main>
  </body>
</html>
