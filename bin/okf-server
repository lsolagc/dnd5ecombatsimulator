#!/usr/bin/env sh
# Serves the .okf bundle on :8808 and restarts the server whenever a file in it changes:
# okf server parses the bundle once and never sees later edits on its own.
# ponytail: polls every 2s, fine for a bundle of a few dozen files.
fingerprint() { find .okf -type f -exec stat -c '%Y %s %n' {} + | sort | md5sum; }
trap 'kill "$pid" 2>/dev/null; exit 0' INT TERM

while :; do
  okf server .okf --bind 0.0.0.0 -p 8808 -t dnd &
  pid=$!
  seen=$(fingerprint)
  while kill -0 "$pid" 2>/dev/null && [ "$(fingerprint)" = "$seen" ]; do sleep 2; done
  kill "$pid" 2>/dev/null
  wait "$pid"
done
